  sessionId: PACIENT-TEST
  startAutomatically: 1
  saveJson: 1
  questions:
  - id: CAL-0
    text: "\xCEntrebare de prob\u0103: ca s\u0103 exersa\u021Bi, alege\u021Bi varianta 5 \u2013 \u201ETotal de acord\u201D."
    dimension: 0
    reverseScored: 0
    expectedAnswer: 5
    flagThreshold: 0
    pairedWith: 
    countsForScore: 0
  - id: CAL-1
    text: "Chiar acum m\u0103 simt \xEEn largul meu."
    dimension: 1
    reverseScored: 0
    expectedAnswer: 0
    flagThreshold: 0
    pairedWith: BIROU-STARE, TRAFIC-STARE, INCENDIU-STARE, LIFT-STARE
    countsForScore: 1
  - id: CAL-2
    text: "C\xE2nd cineva ridic\u0103 tonul la mine, reu\u0219esc s\u0103 \xEEmi p\u0103strez calmul."
    dimension: 4
    reverseScored: 0
    expectedAnswer: 0
    flagThreshold: 0
    pairedWith: BIROU-FURIE
    countsForScore: 1
  - id: CAL-3
    text: "C\xE2nd trebuie s\u0103 iau o decizie repede, de obicei aleg varianta potrivit\u0103."
    dimension: 2
    reverseScored: 0
    expectedAnswer: 0
    flagThreshold: 0
    pairedWith: INCENDIU-DECIZIE, TRAFIC-DECIZIE
    countsForScore: 1
  - id: CAL-4
    text: "Observ u\u0219or c\xE2nd o persoan\u0103 din jurul meu este sup\u0103rat\u0103 sau speriat\u0103."
    dimension: 3
    reverseScored: 0
    expectedAnswer: 0
    flagThreshold: 0
    pairedWith: TRAFIC-EMPATIE, BIROU-EMPATIE
    countsForScore: 1
  - id: CAL-5
    text: "Nu mi s-a \xEEnt\xE2mplat niciodat\u0103 s\u0103 m\u0103 enervez pe cineva."
    dimension: 5
    reverseScored: 1
    expectedAnswer: 0
    flagThreshold: 4
    pairedWith: CAL-2, BIROU-FURIE
    countsForScore: 1
